          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function verificar(nombre, fn) { pm.test(nombre, () => { try { fn(); } catch (error) { pm.execution.setNextRequest(null); throw error; } }); }",
              "try {",
              "verificar('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const r = pm.response.json();",
              "verificar(\"Texto completo sin truncar\", () => { pm.expect(r.contenido).to.eql(pm.variables.get('contenidoLargo')); });",
              "verificar(\"M\\u00e1s de 9500 caracteres\", () => { pm.expect(r.contenido.length).to.be.above(9500); });",
              "}",
              "} catch (error) { pm.execution.setNextRequest(null); pm.test('Respuesta JSON con estructura válida', () => { throw error; }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Buscar literal acentuado al final y por categoría",
      "request": {
        "method": "GET",
        "url": "{{contenidoBaseUrl}}/api/temas?texto={{textoCodificado}}&categoriaId={{categoriaId}}",
        "auth": {
          "type": "noauth"
        },
