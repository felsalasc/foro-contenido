            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function verificar(nombre, fn) { pm.test(nombre, () => { try { fn(); } catch (error) { pm.execution.setNextRequest(null); throw error; } }); }",
              "try {",
              "verificar('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const r = pm.response.json();",
              "verificar(\"Hay categor\\u00eda disponible\", () => { pm.expect(r.length).to.be.above(0); pm.variables.set('categoriaId', r[0].id); });",
              "}",
              "} catch (error) { pm.execution.setNextRequest(null); pm.test('Respuesta JSON con estructura válida', () => { throw error; }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Publicar texto largo con coincidencia final",
      "request": {
        "method": "POST",
        "url": "{{contenidoBaseUrl}}/api/temas",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{temaLargoJson}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cat = Number(pm.variables.get('categoriaId'));",
              "if (!Number.isSafeInteger(cat) || cat <= 0) { pm.execution.setNextRequest(null); throw new Error('Falta categoría válida'); }",
              "pm.variables.set('temaLargoJson', JSON.stringify({titulo:'Temporal Oracle CLOB ' + pm.variables.get('runId'), contenido:pm.variables.get('contenidoLargo'), categoriaId:cat}));",
              "pm.variables.set('temaSenueloJson', JSON.stringify({titulo:'Temporal Oracle señuelo ' + pm.variables.get('runId'), contenido:pm.variables.get('contenidoSenuelo'), categoriaId:cat}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function verificar(nombre, fn) { pm.test(nombre, () => { try { fn(); } catch (error) { pm.execution.setNextRequest(null); throw error; } }); }",
              "try {",
              "verificar('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); } else {",
              "const r = pm.response.json();",
              "if (r.id === undefined || r.id === null) throw new Error('Falta el campo id');",
              "if (pm.response.code === 201) pm.variables.set('largoId', r.id);",
              "verificar(\"Contenido \\u00edntegro al crear\", () => { pm.expect(r.contenido).to.eql(pm.variables.get('contenidoLargo')); });",
              "verificar(\"Autor de identidad\", () => { pm.expect(r.autorId).to.eql(Number(pm.variables.get('adminId'))); });",
              "}",
              "} catch (error) { pm.execution.setNextRequest(null); pm.test('Respuesta JSON con estructura válida', () => { throw error; }); }"
            ]
          }
        }
      ]
    },
